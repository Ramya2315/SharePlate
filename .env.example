# SharePlate Environment Variables Reference
# Copy to .env for local overrides

# Application Host URL (injected automatically in AI Studio / Cloud Run)
APP_URL="http://localhost:3000"

# Server Port
PORT=3000

# Secret for signing JWT access tokens
JWT_SECRET="shareplate-super-secure-production-secret-2026-key"

# Python Intelligence Microservice endpoint
PYTHON_SERVICE_URL="http://127.0.0.1:8000"

# Optional MongoDB Connection String (falls back automatically to persistent file-store if unset)
MONGODB_URI="mongodb://localhost:27017/shareplate"

# Google Maps Platform API Key (Places API New, Routes API, Maps JS)
GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# Node Environment
NODE_ENV="development"
